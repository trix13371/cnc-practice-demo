FROM golang:1.27.3-alpine AS builder
ENV CGO_ENABLED=0 GOMAXPROCS=2 GOTOOLCHAIN=local
WORKDIR /src
# Go's checksum database authenticates the upstream release and module downloads.
RUN go mod download github.com/caddyserver/caddy/v2@v2.11.7 \
    && cp -a /go/pkg/mod/github.com/caddyserver/caddy/v2@v2.11.7/. /src/ \
    && chmod -R u+w /src \
    && go get golang.org/x/net@v0.60.0 github.com/go-chi/chi/v5@v5.4.0 \
    && go build -p 2 -trimpath -ldflags '-s -w -X github.com/caddyserver/caddy/v2.CustomVersion=v2.11.7-security.20261026' -o /out/caddy ./cmd/caddy \
    && cp go.mod go.sum /out/

FROM alpine:3.24.3
RUN apk add --no-cache ca-certificates tzdata \
    && mkdir -p /config/caddy /data/caddy /etc/caddy /srv /usr/share/cnc-proxy
COPY --from=builder /out/caddy /usr/bin/caddy
COPY --from=builder /out/go.mod /out/go.sum /usr/share/cnc-proxy/
ENV XDG_CONFIG_HOME=/config XDG_DATA_HOME=/data
EXPOSE 80 443
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
